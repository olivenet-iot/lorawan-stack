# Olivenet The Things Stack - Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================

# Primary domain for the stack (required)
DOMAIN=lorawan.olivenet.com

# HTTP/HTTPS ports (change if using reverse proxy)
HTTP_PORT=80
HTTPS_PORT=443

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Identity Server)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ttn
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_32CHARS
POSTGRES_DB=ttn_lorawan

# Redis (Cache, Sessions, Task Queue)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_32CHARS

# =============================================================================
# TLS CONFIGURATION
# =============================================================================

# TLS source: "acme" (Let's Encrypt) or "file" (custom certificates)
TLS_SOURCE=acme

# For ACME (Let's Encrypt)
ACME_EMAIL=admin@olivenet.com
ACME_DIR=/var/lib/acme

# For file-based certificates (paths inside container)
# TLS_CERT=/run/secrets/cert.pem
# TLS_KEY=/run/secrets/key.pem
# TLS_CA=/run/secrets/ca.pem

# =============================================================================
# ADMIN CONFIGURATION
# =============================================================================

# Initial admin user (created on first run)
ADMIN_USER_ID=admin
ADMIN_EMAIL=admin@olivenet.com
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# =============================================================================
# SECURITY SECRETS
# =============================================================================

# Console OAuth client secret (generate: openssl rand -hex 32)
CONSOLE_OAUTH_CLIENT_SECRET=GENERATE_32_BYTE_HEX_SECRET_HERE

# Device claiming secret (generate: openssl rand -hex 32)
DEVICE_CLAIMING_SECRET=GENERATE_32_BYTE_HEX_SECRET_HERE

# Network operations key (generate: openssl rand -hex 16)
NETWORK_OPERATIONS_KEY=GENERATE_16_BYTE_HEX_KEY_HERE

# =============================================================================
# EMAIL CONFIGURATION (for account verification, password reset)
# =============================================================================

# SMTP settings
SMTP_HOST=smtp.olivenet.com
SMTP_PORT=587
SMTP_USERNAME=noreply@olivenet.com
SMTP_PASSWORD=SMTP_PASSWORD_HERE
SMTP_FROM=The Things Stack <noreply@olivenet.com>

# =============================================================================
# GATEWAY SERVER CONFIGURATION
# =============================================================================

# UDP Packet Forwarder port
GS_UDP_PORT=1700

# BasicStation WebSocket port
GS_BASICSTATION_PORT=8887

# MQTT port (secure)
GS_MQTT_PORT=8883

# =============================================================================
# CONSOLE CONFIGURATION
# =============================================================================

# Console UI URL (usually same as DOMAIN)
CONSOLE_UI_URL=https://lorawan.olivenet.com/console

# =============================================================================
# NETWORK SERVER CONFIGURATION
# =============================================================================

# NetID for the network (use 000000 for private networks)
NET_ID=000000

# Cluster ID
CLUSTER_ID=olivenet-cluster

# DevAddr prefix
DEV_ADDR_PREFIX=26000000/7

# =============================================================================
# APPLICATION SERVER CONFIGURATION
# =============================================================================

# Webhook queue size and workers
WEBHOOK_QUEUE_SIZE=1000
WEBHOOK_WORKERS=16

# =============================================================================
# BLOB STORAGE
# =============================================================================

# Local storage directory (inside container)
BLOB_LOCAL_DIRECTORY=/srv/ttn-lorawan/public/blob

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: console, json
LOG_FORMAT=json

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Stack container memory limit
STACK_MEMORY_LIMIT=4g

# PostgreSQL shared buffers
POSTGRES_SHARED_BUFFERS=256MB

# Redis max memory
REDIS_MAXMEMORY=512mb

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup directory on host
BACKUP_DIR=/opt/tts-backups

# =============================================================================
# MONITORING (Optional)
# =============================================================================

# Prometheus metrics endpoint
METRICS_ENABLED=true

# Profiling endpoint (set to false in production)
PPROF_ENABLED=false
