# =============================================================================
# Olivenet The Things Stack - Environment Configuration
# =============================================================================
#
# RECOMMENDED: Use deploy.sh to generate this file automatically:
#   ./scripts/deploy.sh
#
# MANUAL: Copy this file to .env and fill in the values:
#   cp .env.example .env
#   nano .env
#
# =============================================================================

# =============================================================================
# DOMAIN CONFIGURATION (Required)
# =============================================================================

# Primary domain for the stack
DOMAIN=lorawan.olivenet.com

# Cluster identifier
CLUSTER_ID=olivenet-tts

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Identity Server)
POSTGRES_USER=ttn
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
POSTGRES_DB=ttn_lorawan
POSTGRES_SHARED_BUFFERS=256MB

# Redis (Cache, Sessions, Task Queue)
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_MAXMEMORY=512mb

# =============================================================================
# TLS CONFIGURATION
# =============================================================================

# TLS source: "acme" (Let's Encrypt) or "file" (custom certificates) or "" (no TLS)
TLS_SOURCE=acme

# For ACME (Let's Encrypt) - required if TLS_SOURCE=acme
ACME_EMAIL=admin@olivenet.com
ACME_DIR=/var/lib/acme

# For file-based certificates (paths inside container)
# TLS_CERT=/run/secrets/cert.pem
# TLS_KEY=/run/secrets/key.pem
# TLS_CA=/run/secrets/ca.pem

# =============================================================================
# OAUTH SECRETS (Generate with: openssl rand -hex 32)
# =============================================================================

CONSOLE_OAUTH_CLIENT_SECRET=GENERATE_32_BYTE_HEX_SECRET_HERE
DEVICE_CLAIMING_SECRET=GENERATE_32_BYTE_HEX_SECRET_HERE

# Cookie keys (Generate: openssl rand -hex 32 and openssl rand -hex 16)
HASH_KEY=GENERATE_32_BYTE_HEX_KEY_HERE
BLOCK_KEY=GENERATE_16_BYTE_HEX_KEY_HERE

# =============================================================================
# LORAWAN NETWORK
# =============================================================================

# NetID for the network (use 000000 for private networks)
NET_ID=000000

# DevAddr prefix (for private networks)
DEV_ADDR_PREFIX=26000000/7

# =============================================================================
# EMAIL CONFIGURATION (Optional - for account verification, password reset)
# =============================================================================

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@olivenet.com

# =============================================================================
# PORTS
# =============================================================================

# Web ports
HTTP_PORT=80
HTTPS_PORT=443

# Gateway ports
GS_UDP_PORT=1700
GS_BASICSTATION_PORT=8887
GS_MQTT_PORT=8883

# =============================================================================
# APPLICATION SERVER
# =============================================================================

WEBHOOK_QUEUE_SIZE=1000
WEBHOOK_WORKERS=16

# =============================================================================
# STORAGE
# =============================================================================

BLOB_LOCAL_DIRECTORY=/srv/ttn-lorawan/public/blob

# =============================================================================
# LOGGING
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: console, json
LOG_FORMAT=json

# =============================================================================
# MONITORING
# =============================================================================

# Prometheus metrics endpoint
METRICS_ENABLED=true

# Profiling endpoint (set to false in production)
PPROF_ENABLED=false

# =============================================================================
# RESOURCE LIMITS
# =============================================================================

# Stack container memory limit
STACK_MEMORY_LIMIT=4g

# =============================================================================
# TESTING & SIMULATION
# =============================================================================

# Default gateway EUI for simulators
# DEFAULT_GATEWAY_EUI=AA555A0000000001

# Simulator settings (optional)
# SIMULATOR_RATE=10
# SIMULATOR_DEVICES=100
